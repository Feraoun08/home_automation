    {
        "id": "daa89ad559bbc129",
        "type": "function",
        "z": "5e19ed0d7bbe1aa9",
        "name": "Format device state for InfluxDB",
        "func": "\nconst topicParts = msg.topic.split(\"/\");\n\n// Expected topic:\n// home/living_room/device/light/state\nif (\n    topicParts.length !== 5 ||\n    topicParts[2] !== \"device\" ||\n    topicParts[4] !== \"state\"\n) {\n    return null;\n}\n\nconst deviceName = topicParts[3];\nconst deviceState = msg.payload?.state;\n\nif (deviceState !== \"on\" && deviceState !== \"off\") {\n    return null;\n}\n\nmsg.payload = [\n    {\n        is_on: deviceState === \"on\" ? 1 : 0\n    },\n    {\n        room: topicParts[1],\n        device_name: deviceName,\n        device_id: msg.payload.device_id\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
