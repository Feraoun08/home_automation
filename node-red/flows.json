    {
        "id": "8d3592580a06fabe",
        "type": "function",
        "z": "8c3bdc4450404a78",
        "name": "Create high temperature alert",
        "func": "\nconst temperature = Number(msg.payload?.value);\n\nif (Number.isNaN(temperature)) {\n    return null;\n}\n\nconst wasHigh = context.get(\"temperatureHigh\") || false;\n\n// Create one alert when temperature crosses 28 °C.\nif (temperature >= 28 && !wasHigh) {\n    context.set(\"temperatureHigh\", true);\n\n    msg.payload = {\n        severity: \"warning\",\n        alert_type: \"high_temperature\",\n        message: `High temperature detected: ${temperature} °C`,\n        timestamp: new Date().toISOString()\n    };\n\n    return msg;\n}\n\n// Reset only after the room has cooled sufficiently.\nif (temperature <= 27 && wasHigh) {\n    context.set(\"temperatureHigh\", false);\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 180,
        "y": 900,
        "wires": [
