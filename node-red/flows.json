        "id": "789a4158417e344a",
        "type": "function",
        "z": "8c3bdc4450404a78",
        "name": "Format alert for InfluxDB",
        "func": "\nconst alert = msg.payload;\nconst topicParts = msg.topic.split(\"/\");\n\nmsg.payload = [\n    {\n        message: alert.message\n    },\n    {\n        severity: alert.severity,\n        alert_type: alert.alert_type,\n        room: topicParts[1]\n    }\n];\n\nreturn msg;",
