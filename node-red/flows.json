    {
        "id": "e2cff44796c084ad",
        "type": "function",
        "z": "5e19ed0d7bbe1aa9",
        "name": "Turn on light on presence",
        "func": "if (msg.payload && msg.payload.value === true) {\n    return {\n        topic: \"home/living_room/device/light/command\",\n        payload: JSON.stringify({\n            state: \"on\",\n            source: \"presence_automation\"\n        })\n    };\n}\n\nreturn null;",
