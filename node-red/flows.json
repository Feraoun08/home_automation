    {
        "id": "20ddf1ce73032c59",
        "type": "function",
        "z": "8c3bdc4450404a78",
        "name": "Control fan by temperature",
        "func": "const temperature = msg.payload?.value;\n\nif (typeof temperature !== \"number\") {\n    return null;\n}\n\nlet requestedState;\n\nif (temperature >= 28) {\n    requestedState = \"on\";\n} else if (temperature <= 24) {\n    requestedState = \"off\";\n} else {\n    return null;\n}\n\n// Avoid sending the same command repeatedly.\nconst lastFanState = context.get(\"lastFanState\");\n\nif (lastFanState === requestedState) {\n    return null;\n}\n\ncontext.set(\"lastFanState\", requestedState);\n\nreturn {\n    topic: \"home/living_room/device/fan/command\",\n    payload: JSON.stringify({\n        state: requestedState,\n        source: \"temperature_automation\",\n        temperature: temperature\n    })\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 640,
        "wires": [
            [
                "2e77d104418d5478"
            ]
        ]
    },
    {
        "id": "ad595c9fcc7fa04f",
        "type": "function",
        "z": "8c3bdc4450404a78",
        "name": "Format sensor reading for InfluxDB",
        "func": "\nconst topicParts = msg.topic.split(\"/\");\n\n// Store sensor messages only.\nif (topicParts.length !== 4 || topicParts[2] !== \"sensor\") {\n    return null;\n}\n\nconst reading = msg.payload;\n\nif (!reading || typeof reading.value === \"undefined\") {\n    return null;\n}\n\nconst sensorType = topicParts[3];\n\n// InfluxDB uses one numeric field called \"value\".\n// Presence becomes 1 (present) or 0 (absent).\nconst numericValue =\n    sensorType === \"presence\"\n        ? (reading.value ? 1 : 0)\n        : Number(reading.value);\n\nif (Number.isNaN(numericValue)) {\n    return null;\n}\n\nmsg.payload = [\n    {\n        value: numericValue\n    },\n    {\n        room: topicParts[1],\n        sensor_type: sensorType,\n        device_id: reading.device_id,\n        unit: reading.unit\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 260,
        "wires": [
            [
                "9ee3bf1788650536"
            ]
        ]
    },
